# Shared secret the Raspberry Pi must send as the `x-api-key` header
# when POSTing to /api/data. Leave unset locally to skip auth during dev,
# but set this in Vercel's Environment Variables for the deployed app.
PI_API_KEY=changeme

# Shared secret the Raspberry Pi must send as `Authorization: Bearer <key>`
# when POSTing to /api/checkin. Must match MAKERSPACE_API_KEY on the Pi side.
# Leave unset locally to skip auth during dev.
MAKERSPACE_API_KEY=changeme
